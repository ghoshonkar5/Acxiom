@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 font-weight-bold">Good evening, @(User.Identity?.Name?.Split('@')[0] ?? "User")</h2>
        <p class="text-secondary">Your follow-up queue is clear for today.</p>
    </div>
    <div class="btn-group" role="group">
        <button type="button" class="btn btn-dark">All time</button>
        <button type="button" class="btn btn-outline-secondary bg-surface text-primary border">Today</button>
        <button type="button" class="btn btn-outline-secondary bg-surface text-primary border">This Week</button>
        <button type="button" class="btn btn-outline-secondary bg-surface text-primary border">This Month</button>
        <button type="button" class="btn btn-outline-secondary bg-surface text-primary border">Custom</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border: none;">
            <div class="card-body position-relative">
                <div class="position-absolute top-0 end-0 p-3">
                    <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-currency-rupee text-white"></i>
                    </div>
                </div>
                <h6 class="text-white-50 mb-3">Total Pipeline Value</h6>
                <h2 class="display-5 fw-bold mb-4">₹@(ViewBag.PipelineValue?.ToString("N0") ?? "0")</h2>
                
                <div class="progress mb-2" style="height: 4px; background-color: rgba(255,255,255,0.1);">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 55%" aria-valuenow="55" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-white-50">Won <strong class="text-white">₹@(ViewBag.WeightedValue?.ToString("N0") ?? "0")</strong> • @ViewBag.OpenOpps open</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body position-relative">
                <div class="position-absolute top-0 end-0 p-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: rgba(59, 130, 246, 0.1);">
                        <i class="bi bi-building text-info"></i>
                    </div>
                </div>
                <h6 class="text-secondary mb-3">Total Customers</h6>
                <h2 class="display-5 fw-bold mb-4">@ViewBag.TotalCustomers</h2>
                <small class="text-secondary"><strong class="text-primary">@ViewBag.ActiveCustomers</strong> active • <span class="text-muted">@ViewBag.InactiveCustomers inactive</span></small>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body position-relative">
                <div class="position-absolute top-0 end-0 p-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: rgba(16, 185, 129, 0.1);">
                        <i class="bi bi-bullseye text-success"></i>
                    </div>
                </div>
                <h6 class="text-secondary mb-3">Total Leads</h6>
                <h2 class="display-5 fw-bold mb-4">@ViewBag.TotalLeads</h2>
                <div class="progress mb-2" style="height: 4px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: 78%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-secondary"><strong class="text-primary">@ViewBag.OpenLeads</strong> open leads</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body position-relative">
                <div class="position-absolute top-0 end-0 p-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: rgba(245, 158, 11, 0.1);">
                        <i class="bi bi-lightning-charge text-warning"></i>
                    </div>
                </div>
                <h6 class="text-secondary mb-3">Open Leads</h6>
                <h2 class="display-5 fw-bold mb-4">@ViewBag.OpenLeads</h2>
                <small class="text-secondary"><strong class="text-danger">@ViewBag.HighPriorityLeads</strong> high priority</small>
            </div>
        </div>
    </div>
</div>
