@model IEnumerable<AcxiomCRM.Data.Models.FollowUp>
@{ ViewData["Title"] = "Follow-ups"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 font-weight-bold mb-0">Follow-ups</h2>
</div>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead class="bg-light"><tr><th>Date</th><th>Lead</th><th>Method</th><th>Status</th><th>Notes</th></tr></thead>
    <tbody>
        @foreach(var item in Model) {
            <tr>
                <td>@item.Date.ToString("MMM dd, yyyy")</td>
                <td><span class="text-primary fw-medium">@(item.Lead?.LeadName ?? "N/A")</span></td>
                <td>@item.Type</td>
                <td>
                    @if(item.Status == "Completed") { <span class="badge badge-success">Completed</span> }
                    else { <span class="badge badge-warning">Pending</span> }
                </td>
                <td>@item.Subject</td>
            </tr>
        }
    </tbody>
</table></div></div></div>
