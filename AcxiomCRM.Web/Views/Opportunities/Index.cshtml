@model IEnumerable<AcxiomCRM.Data.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 font-weight-bold mb-0">Opportunities</h2>
    <a href="#" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Opportunity</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Close Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="text-primary fw-medium">@item.Code</span></td>
                            <td><span class="fw-medium">@item.OpportunityName</span></td>
                            <td>@item.Customer?.CustomerName</td>
                            <td>
                                @if(item.Stage == "Won") { <span class="badge badge-success">Won</span> }
                                else if(item.Stage == "Qualification") { <span class="badge badge-info">Qualification</span> }
                                else { <span class="badge badge-warning">@item.Stage</span> }
                            </td>
                            <td>₹@item.Amount.ToString("N0")</td>
                            <td>@item.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-link text-secondary"><i class="bi bi-three-dots-vertical"></i></button>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()) {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No opportunities found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
