@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--bg-app) 0%, var(--bg-surface) 100%);
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            padding: 2.5rem;
            border-radius: var(--radius-lg);
            background-color: var(--bg-surface);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--border-color);
        }
    </style>
</head>
<body class="login-page">

    <div class="login-card">
        <div class="text-center mb-4">
            <i class="bi bi-heptagon-fill text-primary" style="font-size: 3rem;"></i>
            <h3 class="mt-3 font-weight-bold">Welcome back</h3>
            <p class="text-secondary">Please enter your details to sign in.</p>
        </div>

        <form method="post" asp-controller="Auth" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label for="email" class="form-label font-weight-bold text-secondary">Email</label>
                <input type="email" class="form-control form-control-lg" id="email" name="email" required placeholder="name@acxiom.com">
            </div>
            
            <div class="mb-4">
                <label for="password" class="form-label font-weight-bold text-secondary">Password</label>
                <input type="password" class="form-control form-control-lg" id="password" name="password" required placeholder="••••••••">
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" value="true">
                    <label class="form-check-label text-secondary" for="rememberMe">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
        </form>

        <div class="mt-4 text-center">
            <p class="text-muted small">
                <strong>Demo Accounts:</strong><br/>
                Admin: admin@acxiom.com / Admin@123<br/>
                Manager: priya@acxiom.com / Manager@123<br/>
                Sales: rohan@acxiom.com / Sales@123
            </p>
        </div>
    </div>

</body>
</html>
