@model IEnumerable<AcxiomCRM.Data.Models.Lead>
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 font-weight-bold mb-0">Leads</h2>
    <a href="#" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Lead</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Value</th>
                        <th>Owner</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="text-primary fw-medium">@item.Code</span></td>
                            <td><span class="fw-medium">@item.LeadName</span></td>
                            <td>@item.Source</td>
                            <td>
                                @if(item.Status == "New") { <span class="badge badge-info">New</span> }
                                else if(item.Status == "Qualified") { <span class="badge badge-success">Qualified</span> }
                                else { <span class="badge badge-secondary">@item.Status</span> }
                            </td>
                            <td>₹@item.Value.ToString("N0")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white" style="width: 24px; height: 24px; font-size: 0.7rem;">
                                        @(item.Owner?.FirstName?.Substring(0,1) ?? "U")
                                    </div>
                                    <span class="text-secondary small">@(item.Owner?.FirstName) @(item.Owner?.LastName)</span>
                                </div>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-link text-secondary"><i class="bi bi-three-dots-vertical"></i></button>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()) {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No leads found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
