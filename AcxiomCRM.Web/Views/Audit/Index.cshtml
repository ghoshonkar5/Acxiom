@model IEnumerable<AcxiomCRM.Data.Models.AuditLog>
@{ ViewData["Title"] = "Audit Log"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 font-weight-bold mb-0">System Audit Log</h2></div>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead class="bg-light"><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
    <tbody>
        @foreach(var item in Model) {
            <tr><td>@item.Timestamp.ToString("g")</td><td>@item.UserId</td><td><span class="badge badge-secondary">@item.Action</span></td><td>@item.Module</td><td>@item.Diff</td></tr>
        }
    </tbody>
</table></div></div></div>
