@model IEnumerable<AcxiomCRM.Data.Models.Activity>
@{ ViewData["Title"] = "Activities"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 font-weight-bold mb-0">Activities</h2>
</div>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead class="bg-light"><tr><th>Date</th><th>Type</th><th>Description</th><th>User</th></tr></thead>
    <tbody>
        @foreach(var item in Model) {
            <tr>
                <td>@item.Date.ToString("g")</td>
                <td><span class="badge badge-info">@item.Type</span></td>
                <td>@item.Description</td>
                <td>@(item.Owner?.FirstName) @(item.Owner?.LastName)</td>
            </tr>
        }
    </tbody>
</table></div></div></div>
